<Project Sdk="LibreWPF.Sdk">

  <PropertyGroup>
    <BaseOutputPath Condition="'$(VoidstrapLinuxPackagingRoot)' == ''">$(MSBuildThisFileDirectory)bin-cross\$(RuntimeIdentifier)\</BaseOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputType>Library</OutputType>
    <RootNamespace>Wpf.Ui</RootNamespace>
    <AssemblyName>Wpf.Ui</AssemblyName>
    <NeutralLanguage>en-US</NeutralLanguage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <ProGpuWpfUsePortableFrameworkReferences>true</ProGpuWpfUsePortableFrameworkReferences>
    <ProGpuWpfSystemSecurityCryptographyXmlVersion>10.0.13</ProGpuWpfSystemSecurityCryptographyXmlVersion>
    <ProGpuWpfUsePortableWinFormsCompat>false</ProGpuWpfUsePortableWinFormsCompat>
    <ProGpuWpfUseLibreWinForms>false</ProGpuWpfUseLibreWinForms>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'linux-arm64' Or '$(RuntimeIdentifier)' == 'osx-arm64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'osx-x64'">x64</PlatformTarget>
    <LangVersion>preview</LangVersion>
    <Nullable>annotations</Nullable>
    <EnableSourceLink>false</EnableSourceLink>
    <DeterministicSourcePaths>false</DeterministicSourcePaths>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj-*\**;bin-cross\**;obj\**;bin\**;Tray\Hicon.cs" />
    <Page Remove="obj-*\**;bin-cross\**;obj\**;bin\**" />
    <None Remove="obj-*\**;bin-cross\**;obj\**;bin\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\..\src\Voidstrap.Cross\WpfUi\HiconCrossStub.cs" Link="HiconCrossStub.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wpf.Ui.Abstractions\Wpf.Ui.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="$(MSBuildThisFileDirectory)Fonts\Source\FluentSystemIcons-Filled.ttf" Link="Fonts\Source\FluentSystemIcons-Filled.ttf" />
    <Resource Include="$(MSBuildThisFileDirectory)Fonts\Source\FluentSystemIcons-Regular.ttf" Link="Fonts\Source\FluentSystemIcons-Regular.ttf" />
  </ItemGroup>

</Project>
