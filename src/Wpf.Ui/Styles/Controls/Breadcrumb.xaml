<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:Wpf.Ui.Common"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls">

    <Style x:Key="UiBreadcrumbButton" TargetType="{x:Type Button}" />

    <Style TargetType="{x:Type controls:Breadcrumb}">
        <Setter Property="Foreground">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource TextFillColorPrimary}" />
            </Setter.Value>
        </Setter>
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Breadcrumb}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="PART_Root"
                            Padding="0"
                            Focusable="False"
                            IsHitTestVisible="False"
                            Cursor="Arrow">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border
                                        x:Name="Square"
                                        Margin="-6,0"
                                        Padding="6,0,6,2"
                                        Background="Transparent"
                                        CornerRadius="4">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Square" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Square" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <DockPanel>
                            <controls:SymbolIcon
                                x:Name="RootIcon"
                                DockPanel.Dock="Left"
                                Margin="0,4,6,0"
                                VerticalAlignment="Center"
                                FontSize="23"
                                Foreground="{TemplateBinding Foreground}"
                                Symbol="{TemplateBinding Icon}" />
                            <TextBlock
                                x:Name="RootText"
                                TextTrimming="CharacterEllipsis"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="Medium"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding Current}" />
                            </DockPanel>
                        </Button>
                        <controls:SymbolIcon
                            x:Name="Chevron"
                            Grid.Column="1"
                            Margin="14,4,10,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Symbol="ChevronRight20"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="SubText"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            MaxWidth="360"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{TemplateBinding SubPage}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="Medium"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{TemplateBinding SubPage}"
                            Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Static common:SymbolRegular.Empty}">
                            <Setter TargetName="RootIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasSubPage" Value="True">
                            <Setter TargetName="PART_Root" Property="IsHitTestVisible" Value="True" />
                            <Setter TargetName="RootText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Setter TargetName="RootIcon" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SubText" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
